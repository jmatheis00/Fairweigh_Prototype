# Template for the local .env. Never commit real values.
# Copy with: cp .env.example .env

# Port of the NestJS server (3001 locally)
PORT=3001

# Address at which the cockpit reaches the server
SERVER_URL=http://localhost:3001

# Folder with the simulated source systems, one sub-folder each (default: ../data/sources, seen from server/)
# DATA_DIR=/app/data/sources

# AI provider: fake (default, local only), gemini
LLM_PROVIDER=fake

# Only for LLM_PROVIDER=gemini. Key from Google AI Studio, never commit it.
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# Folder for saved real runs (default: ../data/runs, seen from server/)
# RUNS_DIR=/app/data/runs
